# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# app log files (dev + prod user logs)
/logs/*.log
/logs/users/
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# graphify semantic tree
graphify-out
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
